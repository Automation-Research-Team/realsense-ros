          camera_color_frame:
            camera_color_optical_frame:
              {}
          camera_depth_frame:
            camera_depth_optical_frame:
              {}
          camera_infra1_frame:
            {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 0.517978847026825
        Min Value: -0.20583470165729523
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
